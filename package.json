    "i18next": "^27.2.9",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.5",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
