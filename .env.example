# ──────────────────────────────────────────────
# Frontend – Supabase (cloud projects)
# Without these values the app runs with local projects only.
# ──────────────────────────────────────────────
# Local stack: http://127.0.0.1:54321 and the key from `yarn supabase status`
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ──────────────────────────────────────────────
# Docker Compose (docker-compose.yml)
# ──────────────────────────────────────────────
PROJEKT_PLANER_VERSION=latest
PROJEKT_PLANER_PORT=8080

# ──────────────────────────────────────────────
# Container start – read by docker/entrypoint.sh only
# Leave empty to skip the respective step.
# Vite exposes every SUPABASE_* variable to the browser (envPrefix in
# vite.config.js), so keep SUPABASE_ACCESS_TOKEN out of the .env you use
# for yarn dev / yarn build and pass it to the container only.
# ──────────────────────────────────────────────
# Postgres connection string, runs pending migrations from supabase/migrations/
DATABASE_URL=

# Supabase Management API, deploys the Edge Functions and sets the auth site_url
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Public URL of your instance, used as the Supabase auth site_url
PROJEKT_PLANER_URL=http://localhost:8080

# ──────────────────────────────────────────────
# SMTP – emails sent by the Edge Functions
# ──────────────────────────────────────────────
SMTP_HOSTNAME=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
