# Projekt-Planer with self-hosted Supabase (docker-compose.self-hosted.yml)
#
#   cp .env.self-hosted.example .env
#   sh scripts/generate-supabase-secrets.sh
#
# Never run with the placeholder secrets below.

# ──────────────────────────────────────────────
# Public URLs, as the browser sees them
# ──────────────────────────────────────────────
# The app (port PROJEKT_PLANER_PORT, or your reverse proxy in front of it)
PROJEKT_PLANER_URL=http://localhost:8080
# The Supabase API gateway (port SUPABASE_API_PORT, or your reverse proxy)
SUPABASE_PUBLIC_URL=http://localhost:8000

PROJEKT_PLANER_PORT=8080
SUPABASE_API_PORT=8000
PROJEKT_PLANER_VERSION=latest

# ──────────────────────────────────────────────
# Secrets, generated by scripts/generate-supabase-secrets.sh
# ──────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me
SECRET_KEY_BASE=change-me
REALTIME_DB_ENC_KEY=change-me

# ──────────────────────────────────────────────
# Mail, used for sign-up confirmation, password reset and invitations
# ──────────────────────────────────────────────
SMTP_HOSTNAME=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_SENDER_NAME=Projekt-Planer

# ──────────────────────────────────────────────
# Optional
# ──────────────────────────────────────────────
# Skip the confirmation mail after sign-up (only for closed setups)
ENABLE_EMAIL_AUTOCONFIRM=false
# Only allow invited users
DISABLE_SIGNUP=false
JWT_EXPIRY=3600
FUNCTIONS_MEMORY_LIMIT=1g
